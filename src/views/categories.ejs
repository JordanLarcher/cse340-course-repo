<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2>Browse by Category</h2>
        <div class="category-grid">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="category-card"><%= category.name %></a>
            <% }); %>
        </div>
        <% if (user && user.role_name === 'admin') { %>
            <div class="add-btn">
                <a href="/new-category">Add a New Category</a>
            </div>
        <% } %>
    </main>
<%- include('partials/footer') %>
