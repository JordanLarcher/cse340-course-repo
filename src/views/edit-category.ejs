<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-category/<%= category.category_id %>?_method=PUT" method="POST" class="form-container">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input
                    type="text"
                    id="name"
                    name="name"
                    maxlength="100"
                    value="<%= category.name %>"
                    required
            />
        </div>

        <button type="submit" class="btn">Update Category</button>
    </form>
</main>
<%- include('partials/footer') %>
