<%- include('partials/header') %>
<main>
    <a href="/organizations" class="back-link">&larr; Back to Organizations</a>
    <h1><%= organizationDetails.name %></h1>

    <div class="project-detail">
        <% if (organizationDetails.logo_filename) { %>
            <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo" class="org-logo">
        <% } %>

        <p><strong>Description:</strong> <%= organizationDetails.description %></p>

        <h3>Service Projects</h3>
        <ul>
            <% if (projects.length === 0) { %>
                <li class="empty-state">No service projects found.</li>
            <% } else { %>
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <strong><%= project.title %></strong>
                            <span class="project-date"><%= project.project_date ? new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '' %></span>
                        </a>
                    </li>
                <% }) %>
            <% } %>
        </ul>
    </div>

    <% if (user && user.role_name === 'admin') { %>
        <div class="add-btn">
            <a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>
