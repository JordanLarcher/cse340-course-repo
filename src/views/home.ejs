<%- include('partials/header') %>

<main class="home">
    <section class="hero">
        <img class="main-logo" src="/images/cse340-service-network.png" alt="CSE 340 Service Network Logo">
        <h1><%= title %></h1>
        <p class="tagline">Connect. Serve. Make a Difference.</p>
    </section>

    <section class="mission">
        <h2>Welcome to the CSE 340 Service Network!</h2>
        <p>Our mission is to promote service across the world by connecting volunteers with service opportunities in their community.</p>
    </section>

    <section class="quick-links">
        <a href="/organizations" class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/><path d="M10 10h4"/></svg></span>
            <span class="card-title">Organizations</span>
            <span class="card-desc">Browse partner organizations leading service projects</span>
        </a>
        <a href="/projects" class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg></span>
            <span class="card-title">Projects</span>
            <span class="card-desc">Find upcoming service opportunities near you</span>
        </a>
        <a href="/categories" class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v4H4z"/><path d="M4 16h16v4H4z"/><path d="M4 10h16v2H4z"/><path d="M4 14h16v1H4z"/></svg></span>
            <span class="card-title">Categories</span>
            <span class="card-desc">Explore projects by category and interest</span>
        </a>
    </section>

    <% if (isLoggedIn) { %>
        <div class="dashboard-link">
            <a href="/dashboard">My Dashboard</a>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
