<%- include('partials/header') %>

    <main>
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong><%= project.title %></strong>
                        <span class="project-date"><%= project.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </a>
                    <span class="project-org"><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></span>
                </li>
            <% }) %>
        </ul>
        <% if (user && user.role_name === 'admin') { %>
            <div class="add-btn">
                <a href="/new-project">Add a New Service Project</a>
            </div>
        <% } %>
    </main>

<%- include('partials/footer') %>
