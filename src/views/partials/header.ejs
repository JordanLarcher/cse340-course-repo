<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav class="site-nav">
        <div class="nav-inner">
            <ul>
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="/organizations" class="nav-link">Organizations</a></li>
                <li><a href="/projects" class="nav-link">Projects</a></li>
                <li><a href="/categories" class="nav-link">Categories</a></li>
                <% if(user && user.role_name === 'admin'){%>
                    <li><a href="/users" class="nav-link">Users</a></li>
                <% } %>
            </ul>
            <ul>
                <% if(!isLoggedIn){%>
                    <li><a href="/register" class="nav-link">Register</a></li>
                    <li><a href="/login" class="nav-link">Login</a></li>
                <% } else { %>
                    <li><a href="/dashboard" class="nav-link">Dashboard</a></li>
                    <li>
                        <form action="/logout" method="POST" style="display:inline">
                            <button type="submit" class="nav-link-btn">Logout</button>
                        </form>
                    </li>
                <% } %>
            </ul>
        </div>
    </nav>

    <% const messages = flash(); %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            <div class="flash-container">
            <% messages[type].forEach(msg => { %>
                <div class="alert alert-<%= type %>"><%= msg %></div>
            <% }); %>
            </div>
        <% } %>
    <% }); %>