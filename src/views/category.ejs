<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Service Projects in this category</h2>
    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong><%= project.title %></strong>
                        <span class="project-date"><%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </a>
                    <div class="project-org">
                        Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </div>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p class="empty-state">No projects in this category yet.</p>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <div class="add-btn">
            <a href="/edit-category/<%= category.category_id %>">Edit Category</a>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>
