<%- include('partials/header') %>

    <main>
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
        <ul>
            <% if (organizations.length === 0) { %>
                <li class="empty-state">No partner organizations yet.</li>
            <% } else { %>
                <% organizations.forEach(organization => { %>
                <li>
                    <a href="/organization/<%= organization.organization_id %>" class="org-card-link">
                        <div class="org-card-content">
                            <div class="org-img-name">
                                <% if (organization.logo_filename) { %>
                                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                                <% } %>
                                <span><%= organization.name %></span>
                            </div>
                            <span class="org-contact-info"><%= organization.contact_email %></span>
                        </div>
                    </a>
                </li>
            <% }); %>
            <% } %>
    </ul>

    <% if (user && user.role_name === 'admin') { %>
        <div class="add-btn">
            <a href="/new-organization">Add a New Organization</a>
        </div>
    <% } %>
    </main>

<%- include('partials/footer') %>
