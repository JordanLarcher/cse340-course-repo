<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Registered Volunteers and Administrators</h2>
    <p>A list of all users currently registered in the service network.</p>

    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><strong><%= user.name %></strong></td>
                    <td><%= user.email %></td>
                    <td><span class="tag"><%= user.role_name %></span></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</main>
<%- include('partials/footer') %>
