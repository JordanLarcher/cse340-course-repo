<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-organization/<%= organizationDetails.organization_id %>?_method=PUT" method="POST" class="form-container">
        <div class="form-group">
            <label for="name">Organization Name</label>
            <input
                    type="text"
                    id="name"
                    name="name"
                    maxlength="150"
                    value="<%= organizationDetails.name %>"
                    required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                    id="description"
                    name="description"
                    maxlength="500"
                    required
            ><%= organizationDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email</label>
            <input
                    type="email"
                    id="contactEmail"
                    name="contactEmail"
                    value="<%= organizationDetails.contact_email %>"
                    required
            />
        </div>

        <button type="submit" class="btn">Update Organization</button>
    </form>
</main>
<%- include('partials/footer') %>
