<%- include('partials/header') %>

<main>
    <a href="/projects" class="back-link">&larr; Back to Projects</a>
    <h1><%= project.title %></h1>

    <div class="category-tags">
        <strong>Categories:</strong>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="category-tag"><%= category.name %></a>
            <% }) %>
        <% } else { %>
            <span>No categories assigned.</span>
        <% } %>
    </div>

    <div class="project-detail">
        <% if (project) { %>
            <h2><%= project.title %></h2>
            <p><strong>Date:</strong> <%= project.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
            <p><strong>Location:</strong> <%= project.location %></p>
            <p><strong>Description:</strong> <%= project.description %></p>
        <% } else { %>
            <p class="project-not-found">Project not found.</p>
        <% } %>
    </div>

    <% if (project && user && user.role_name === 'admin') { %>
        <div class="add-btn">
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
        </div>
    <% } else if (project && user) { %>
        <div class="project-volunteer-form">
            <% if (isVolunteer) { %>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit" class="btn-remove">Remove Volunteer</button>
                </form>
            <% } else { %>
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit" class="btn-volunteer">Volunteer</button>
                </form>
            <% } %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
